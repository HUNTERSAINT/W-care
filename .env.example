# Postgres connection string (Railway provides this)
DATABASE_URL=postgres://user:pass@localhost:5432/carebot
# Set to true only if your Postgres requires SSL
PGSSL=false

# Google Gemini (free key: https://aistudio.google.com/apikey). Same variable names as Postwave.
GEMINI_API_KEY=
# Optional. Leave empty and the bot picks the best available Gemini flash model by itself.
GEMINI_MODEL=

# Optional. Lets the website reader open JavaScript-only sites faster and with higher limits
# (free key at https://jina.ai/reader). Works without it, just slower.
JINA_API_KEY=

# Dashboard/API password (long random string)
ADMIN_TOKEN=change-me-to-something-long

# Where WhatsApp login sessions are stored. On Railway, mount a volume at /data
SESSIONS_DIR=./sessions

# Numbers starting with 0 get this country code prepended (234 = Nigeria)
DEFAULT_COUNTRY_CODE=234

# Hours the bot stays quiet in a chat after the owner replies manually
OWNER_PAUSE_HOURS=12

PORT=3000
